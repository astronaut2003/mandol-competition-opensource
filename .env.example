# Variable names only; this file is not loaded automatically.
# Export values or inject them with a secret manager. Never commit real values.
MANDOL_MEMORY_SYSTEM_KEY=
DASHSCOPE_API_KEY=
CLOSEAI_API_KEY=
MANDOL_MM_VLM_API_KEY_ENV=CLOSEAI_API_KEY
MANDOL_MM_VLM_MODEL=gpt-4o-mini-closeai
MANDOL_MM_VLM_REQUEST_MODEL=gpt-4o-mini
MANDOL_MULTIMODAL_VLM_ENDPOINT=https://vlm.example.invalid/v1
MANDOL_MM_MODEL_DEVICE=external-http
# Copy and edit the serving manifest, then point this variable to that local file.
MANDOL_INFERENCE_BINDINGS=configs/deployment/serving-bindings.example.json
# Optional same-model, whole-attempt reranker replicas (never mix model recipes):
# MANDOL_TEXTUAL_RERANKER_REPLICAS=http://127.0.0.1:8003
# MANDOL_MULTIMODAL_RERANKER_REPLICAS=http://127.0.0.1:18621
